# FINN Environment Configuration Example

# Server & Network
PORT=8000
HOST=0.0.0.0
FINN_ENV=development

# Storage & Persistence
DATA_DIR=./data
DATABASE_PATH=./data/finn.db

# Security & Session Scope
SESSION_SECRET=dev-finn-session-secret-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Background Worker & Polling
WORKER_ENABLED=true
NSE_POLL_INTERVAL_SECONDS=900
PRICE_REFRESH_TIME_IST=18:30

# LLM Providers (Optional for T01; strictly server-side)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
